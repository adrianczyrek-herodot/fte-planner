// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  user
  manager
  // Obsługa kadrowo-finansowa: słowniki i stawki, bez wglądu w resztę.
  finance
  admin
}

enum UserStatus {
  pending
  approved
  inactive
}

// ---------------------------------------------------------------------------
// Domain + Auth.js models
// ---------------------------------------------------------------------------

// Pracownik i użytkownik logujący się to ta sama encja (jedna tabela).
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  firstName    String
  lastName     String
  positionId   String? // stanowisko ze słownika globalnego
  position     Position?  @relation(fields: [positionId], references: [id], onDelete: SetNull)
  skills       Skill[] // kompetencje ze słownika globalnego
  role         Role       @default(user)
  status       UserStatus @default(pending)

  // Moment anonimizacji (RODO art. 17). Ustawiany bezpowrotnie: dane osobowe są
  // wtedy nadpisywane, a rekord zostaje wyłącznie po to, by nie rozsypać
  // historii obsady i kosztów projektów. null = zwykły, nietknięty pracownik.
  anonymizedAt DateTime?

  // Pola wymagane/używane przez adapter Auth.js (opcjonalne przy credentials).
  name          String?
  emailVerified DateTime?
  image         String?

  accounts            Account[]
  sessions            Session[]
  assignments         Assignment[]
  passwordResetTokens PasswordResetToken[]
  rates               EmployeeRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([positionId])
}

// ---------------------------------------------------------------------------
// Słowniki globalne
// ---------------------------------------------------------------------------

// Stanowiska — jedna lista dla profili pracowników i dla zapotrzebowania na
// role w projektach. Relacja, a nie tekst, żeby zmiana nazwy propagowała się
// wszędzie i żeby stawka per stanowisko miała się do czego przyczepić.
model Position {
  id   String @id @default(cuid())
  name String @unique

  users        User[]
  projectRoles ProjectRole[]
  rates        PositionRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Kompetencje przypisywane pracownikom jako tagi.
model Skill {
  id   String @id @default(cuid())
  name String @unique

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Jednorazowe tokeny do ustawienia/resetu hasła (zaproszenie pracownika,
// „nie pamiętam hasła"). Przechowujemy hash tokenu — surowy trafia tylko do
// linku wysyłanego użytkownikowi.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?  @db.Decimal(12, 2) // budżet wstępny

  // Linki do zasobów prowadzonych poza aplikacją (karta projektu, ryzyka,
  // dokumentacja, tablica, domena produktu).
  projectCardUrl String?
  riskCardUrl    String?
  confluenceUrl  String?
  miroUrl        String?
  domainUrl      String?

  attachments Attachment[]
  roles       ProjectRole[]
  costItems   ProjectCostItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Zapotrzebowanie na stanowisko w projekcie: rola + okres + wymagane FTE.
// Ludzi przypisujemy do tego slotu (Assignment) — różne osoby na tę samą rolę
// w różnych okresach są w pełni możliwe.
model ProjectRole {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  positionId  String // stanowisko ze słownika globalnego
  position    Position @relation(fields: [positionId], references: [id])
  // Okres z dokładnością do dnia. Wcześniej były to całe miesiące ("YYYY-MM"),
  // co rozjeżdżało się z datami projektu, które od początku są dzienne.
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  requiredFte Decimal  @db.Decimal(4, 2)

  // Ilu ludzi ma stanąć na tej roli. Pokrycie liczymy z FTE, ale liczba osób
  // jest pilnowana osobno — 2.0 FTE można obsadzić dwiema osobami na całość
  // albo czterema na pół etatu, a to nie to samo zapotrzebowanie.
  requiredPeople Int?

  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([positionId])
}

model Attachment {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileName  String

  createdAt DateTime @default(now())

  @@index([projectId])
}

// Obsada slotu: osoba przypisana do roli na dany okres z określonym FTE.
model Assignment {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectRoleId String
  projectRole   ProjectRole @relation(fields: [projectRoleId], references: [id], onDelete: Cascade)

  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  fte       Decimal  @db.Decimal(4, 2)

  // Wyliczane: w którymkolwiek POKRYTYM DNIU suma FTE usera > 1.0. Wcześniej
  // liczone per miesiąc — przy okresach dziennych miesięczna suma zawyżała
  // konflikt dla osób, które po prostu zmieniały projekt w połowie miesiąca.
  isConflict Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectRoleId])
}

// ---------------------------------------------------------------------------
// Warstwa kosztowa
// ---------------------------------------------------------------------------

// Stawki są GODZINOWE i mają datę obowiązywania. Nie nadpisujemy poprzedniej
// wartości, tylko dokładamy kolejną — dzięki temu koszt marca liczy się stawką
// z marca i raport sprzed pół roku nie zmienia się po podwyżce.
//
// Stawka pracownika i stawka stanowiska są osobnymi tabelami, a nie jedną z
// dwoma opcjonalnymi kluczami: każda ma inny właściciel, inny cykl życia i
// prostszą walidację. Przy liczeniu obowiązuje reguła: stawka pracownika,
// a gdy jej brak — uśredniona stawka jego stanowiska.
model EmployeeRate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  hourlyRate Decimal  @db.Decimal(10, 2) // PLN za godzinę
  validFrom  DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, validFrom])
  @@index([userId])
}

model PositionRate {
  id         String   @id @default(cuid())
  positionId String
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  hourlyRate Decimal  @db.Decimal(10, 2) // PLN za godzinę
  validFrom  DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([positionId, validFrom])
  @@index([positionId])
}

enum CostCategory {
  tools
  hardware
  software
  other
}

// Koszty stałe projektu poza wynagrodzeniami: narzędzia, sprzęt, licencje.
model ProjectCostItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name     String
  category CostCategory @default(other)
  amount   Decimal      @db.Decimal(12, 2) // PLN

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Auth.js adapter models (OAuth-ready; credentials używa strategii JWT)
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Dziennik zdarzeń (rozliczalność — RODO art. 5 ust. 2)

enum AuditAction {
  employee_anonymized
  employee_deactivated
  employee_activated
  employee_role_changed
}

/// Ślad po operacjach nieodwracalnych lub zmieniających czyjeś uprawnienia.
///
/// Dwie decyzje są tu świadome i warto je znać:
///
/// 1. BRAK KLUCZY OBCYCH do User. Relacja z kaskadą skasowałaby dziennik razem
///    z użytkownikiem, czyli dokładnie wtedy, gdy wpis jest najbardziej
///    potrzebny. Imiona rozwiązujemy dopiero przy odczycie.
///
/// 2. BRAK DANYCH OSOBOWYCH w samym wpisie — trzymamy wyłącznie identyfikatory.
///    Zapisanie tu imienia i nazwiska sprawiłoby, że przeżyłyby anonimizację i
///    zniweczyły jej sens.
model AuditEvent {
  id String   @id @default(cuid())
  at DateTime @default(now())

  /// Kto wykonał operację. null, gdy zdarzenie pochodzi spoza sesji.
  actorId String?

  action AuditAction

  /// Kogo operacja dotyczyła.
  targetUserId String?

  /// Kontekst bez danych osobowych, np. "rola: pracownik → administrator".
  details String?

  @@index([at])
  @@index([targetUserId])
}

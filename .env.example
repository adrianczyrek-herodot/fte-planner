# Skopiuj do `.env` i uzupełnij wartościami. NIE commituj `.env` (jest w .gitignore).
# Na Vercelu te same klucze ustaw w Project → Settings → Environment Variables.

# Połączenie z Postgresem.
# Lokalnie: kontener Docker. Na produkcji: hostowany Postgres (Neon / Vercel Postgres),
# adres wtedy w stylu: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/fte_planner?schema=public"

# Sekret do podpisywania sesji (NextAuth). Wygeneruj: openssl rand -base64 32
AUTH_SECRET=""

# Bazowy adres aplikacji — używany do budowania linków w mailach (zaproszenie/reset hasła).
# Lokalnie: http://localhost:3000. Na produkcji: https://<twoj-projekt>.vercel.app
APP_URL="http://localhost:3000"

# Token do Vercel Blob (załączniki projektów). Z panelu: Storage → Blob Store.
# Opcjonalny lokalnie — bez niego upload/pobieranie załączników nie zadziała, reszta tak.
BLOB_READ_WRITE_TOKEN=""
